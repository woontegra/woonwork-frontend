# PostgreSQL
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/woonwork?schema=public"

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed
SEED_ADMIN_EMAIL=admin@woontegra.com
SEED_ADMIN_PASSWORD=WoontegraAdmin123!

NODE_ENV=development

# Vercel Blob (server-only — asla VITE_ ile web'e koyma)
BLOB_READ_WRITE_TOKEN=

# Upload limits (MB)
MAX_IMAGE_UPLOAD_MB=20
MAX_VIDEO_UPLOAD_MB=500
MAX_DOCUMENT_UPLOAD_MB=100

# Frontend (OAuth callback redirect)
FRONTEND_URL=http://localhost:5173

# Meta (Facebook Login for Business + Instagram API with Facebook Login)
# Secret'ları frontend bundle'a (VITE_) koymayın.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_OAUTH_REDIRECT_URI=http://localhost:4000/api/social/meta/oauth/callback
META_LOGIN_CONFIG_ID=
SOCIAL_TOKEN_ENCRYPTION_KEY=change-me-social-token-encryption-key-32
