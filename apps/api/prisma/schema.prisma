generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantRole {
  OWNER
  ADMIN
  EDITOR
  MEMBER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BlockType {
  PARAGRAPH
  HEADING_1
  HEADING_2
  HEADING_3
  BULLETED_LIST
  NUMBERED_LIST
  TODO
  QUOTE
  CALLOUT
  DIVIDER
  CODE
  IMAGE
  VIDEO
  FILE
  DATABASE
  SUBPAGE
}

enum MediaCategory {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum DatabasePropertyType {
  TITLE
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  STATUS
  DATE
  CHECKBOX
  URL
  EMAIL
  PHONE
  PERSON
}

enum DatabaseViewType {
  TABLE
  KANBAN
  CALENDAR
}

/// Area listing/access:
/// PRIVATE — only members; hidden from non-members in area directory
/// MEMBERS — only explicitly added members (invite-only)
/// TENANT — every tenant member can access
enum WorkspaceAreaVisibility {
  PRIVATE
  MEMBERS
  TENANT
}

enum WorkspaceAreaRole {
  OWNER
  EDITOR
  MEMBER
  VIEWER
}

enum ContentResourceType {
  PAGE
  DATABASE
  PROJECT
}

enum SharePermission {
  VIEW
  EDIT
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  PINTEREST
  YOUTUBE
}

enum SocialContentType {
  POST
  CAROUSEL
  REEL
  STORY
  VIDEO
  SHORT
  ARTICLE
  PIN
}

enum SocialContentStatus {
  IDEA
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  CANCELLED
}

enum SocialProvider {
  META
}

enum SocialConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum SocialPublicationStatus {
  PENDING
  READY
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum SocialHashtagStatus {
  ACTIVE
  BLOCKED
  DISABLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships         TenantMember[]
  refreshTokens       RefreshToken[]
  createdProjects     Project[]              @relation("ProjectCreatedBy")
  createdTasks        Task[]                 @relation("TaskCreatedBy")
  assignedTasks       Task[]                 @relation("TaskAssignee")
  createdPages        Page[]                 @relation("PageCreatedBy")
  uploadedMedia       MediaAsset[]           @relation("MediaUploadedBy")
  createdBlocks       Block[]                @relation("BlockCreatedBy")
  createdDatabases    Database[]             @relation("DatabaseCreatedBy")
  createdDbRows       DatabaseRow[]          @relation("DatabaseRowCreatedBy")
  createdAreas        WorkspaceArea[]        @relation("AreaCreatedBy")
  areaMemberships     WorkspaceAreaMember[]
  contentSharesOwned  ContentShare[]         @relation("ShareCreatedBy")
  contentSharesReceived ContentShare[]       @relation("ShareReceivedBy")
  favorites           Favorite[]
  recentItems         RecentItem[]
  createdSocialBrands SocialBrand[]         @relation("SocialBrandCreatedBy")
  createdSocialContents SocialContent[]     @relation("SocialContentCreatedBy")
  socialConnections     SocialConnection[]    @relation("SocialConnectionCreatedBy")
  socialOAuthSessions   SocialOAuthSession[]
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            TenantMember[]
  projects           Project[]
  tasks              Task[]
  pages              Page[]
  media              MediaAsset[]
  blocks             Block[]
  databases          Database[]
  databaseProperties DatabaseProperty[]
  databaseRows       DatabaseRow[]
  databaseCells      DatabaseCell[]
  databaseViews      DatabaseView[]
  workspaceAreas     WorkspaceArea[]
  areaMembers        WorkspaceAreaMember[]
  contentShares      ContentShare[]
  favorites          Favorite[]
  recentItems        RecentItem[]
  socialBrands       SocialBrand[]
  socialContents     SocialContent[]
  socialContentPlatforms SocialContentPlatform[]
  socialContentMedia SocialContentMedia[]
  socialConnections  SocialConnection[]
  socialAccounts     SocialAccount[]
  socialOAuthSessions SocialOAuthSession[]
  socialContentDestinations SocialContentDestination[]
  socialHashtags     SocialHashtag[]
}

model TenantMember {
  id        String     @id @default(cuid())
  userId    String
  tenantId  String
  role      TenantRole
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Project {
  id              String        @id @default(cuid())
  tenantId        String
  workspaceAreaId String?
  name            String
  description     String?
  status          ProjectStatus @default(ACTIVE)
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceArea WorkspaceArea? @relation(fields: [workspaceAreaId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  tasks         Task[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, workspaceAreaId])
  @@index([workspaceAreaId])
}

model Task {
  id          String       @id @default(cuid())
  tenantId    String
  projectId   String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  dueDate     DateTime?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee  User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User     @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([projectId])
  @@index([assigneeId])
}

model Page {
  id              String   @id @default(cuid())
  tenantId        String
  workspaceAreaId String?
  parentId        String?
  title           String
  icon            String?
  coverUrl        String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceArea WorkspaceArea? @relation(fields: [workspaceAreaId], references: [id], onDelete: SetNull)
  parent        Page?          @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      Page[]         @relation("PageHierarchy")
  createdBy     User           @relation("PageCreatedBy", fields: [createdById], references: [id])
  blocks        Block[]
  databases     Database[]

  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, workspaceAreaId])
  @@index([workspaceAreaId])
}

model Block {
  id            String    @id @default(cuid())
  tenantId      String
  pageId        String
  parentBlockId String?
  type          BlockType
  content       Json
  position      Float
  mediaAssetId  String?
  databaseId    String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  page        Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("BlockCreatedBy", fields: [createdById], references: [id])
  parentBlock Block?      @relation("BlockHierarchy", fields: [parentBlockId], references: [id], onDelete: Cascade)
  children    Block[]     @relation("BlockHierarchy")
  mediaAsset  MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  database    Database?   @relation(fields: [databaseId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, pageId])
  @@index([pageId, position])
  @@index([parentBlockId])
  @@index([mediaAssetId])
  @@index([databaseId])
}

model Database {
  id              String   @id @default(cuid())
  tenantId        String
  workspaceAreaId String?
  pageId          String?
  name            String
  description     String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceArea WorkspaceArea?     @relation(fields: [workspaceAreaId], references: [id], onDelete: SetNull)
  page          Page?              @relation(fields: [pageId], references: [id], onDelete: SetNull)
  createdBy     User               @relation("DatabaseCreatedBy", fields: [createdById], references: [id])
  properties    DatabaseProperty[]
  rows          DatabaseRow[]
  views         DatabaseView[]
  blocks        Block[]

  @@index([tenantId])
  @@index([tenantId, updatedAt])
  @@index([tenantId, workspaceAreaId])
  @@index([pageId])
  @@index([workspaceAreaId])
}

model WorkspaceArea {
  id          String                  @id @default(cuid())
  tenantId    String
  name        String
  description String?
  icon        String?
  visibility  WorkspaceAreaVisibility @default(MEMBERS)
  createdById String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User                  @relation("AreaCreatedBy", fields: [createdById], references: [id])
  members   WorkspaceAreaMember[]
  pages         Page[]
  databases     Database[]
  projects      Project[]
  socialBrands  SocialBrand[]
  socialContents SocialContent[]

  @@index([tenantId])
  @@index([tenantId, name])
}

model WorkspaceAreaMember {
  id        String            @id @default(cuid())
  tenantId  String
  areaId    String
  userId    String
  role      WorkspaceAreaRole @default(MEMBER)
  createdAt DateTime          @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  area   WorkspaceArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([areaId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([areaId])
}

/// Polymorphic share (validated in service). No public links.
model ContentShare {
  id               String              @id @default(cuid())
  tenantId         String
  resourceType     ContentResourceType
  resourceId       String
  sharedWithUserId String
  permission       SharePermission     @default(VIEW)
  createdById      String
  createdAt        DateTime            @default(now())

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sharedWithUser User   @relation("ShareReceivedBy", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  createdBy      User   @relation("ShareCreatedBy", fields: [createdById], references: [id])

  @@unique([tenantId, resourceType, resourceId, sharedWithUserId])
  @@index([tenantId, sharedWithUserId])
  @@index([tenantId, resourceType, resourceId])
}

model Favorite {
  id           String              @id @default(cuid())
  tenantId     String
  userId       String
  resourceType ContentResourceType
  resourceId   String
  createdAt    DateTime            @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, resourceType, resourceId])
  @@index([tenantId, userId])
}

model RecentItem {
  id           String              @id @default(cuid())
  tenantId     String
  userId       String
  resourceType ContentResourceType
  resourceId   String
  lastOpenedAt DateTime            @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, resourceType, resourceId])
  @@index([tenantId, userId, lastOpenedAt])
}

model DatabaseProperty {
  id         String                @id @default(cuid())
  tenantId   String
  databaseId String
  name       String
  type       DatabasePropertyType
  position   Float
  config     Json?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  database Database      @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  cells    DatabaseCell[]

  @@index([tenantId])
  @@index([databaseId, position])
  @@index([tenantId, databaseId])
}

model DatabaseRow {
  id          String   @id @default(cuid())
  tenantId    String
  databaseId  String
  position    Float
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  database  Database       @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdBy User           @relation("DatabaseRowCreatedBy", fields: [createdById], references: [id])
  cells     DatabaseCell[]

  @@index([tenantId])
  @@index([databaseId, position])
  @@index([tenantId, databaseId])
}

model DatabaseCell {
  id         String   @id @default(cuid())
  tenantId   String
  rowId      String
  propertyId String
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  row      DatabaseRow      @relation(fields: [rowId], references: [id], onDelete: Cascade)
  property DatabaseProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([rowId, propertyId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([tenantId, rowId])
}

model DatabaseView {
  id         String           @id @default(cuid())
  tenantId   String
  databaseId String
  name       String
  type       DatabaseViewType @default(TABLE)
  config     Json
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  database Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([databaseId])
  @@index([tenantId, databaseId])
}

model MediaAsset {
  id               String        @id @default(cuid())
  tenantId         String
  uploadedById     String
  originalFileName String
  fileName         String
  mimeType         String
  size             Int
  storageProvider  String
  storageKey       String
  url              String?
  width            Int?
  height           Int?
  duration         Float?
  category         MediaCategory
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User                 @relation("MediaUploadedBy", fields: [uploadedById], references: [id])
  blocks     Block[]
  socialMedia SocialContentMedia[]

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([storageKey])
}

model SocialBrand {
  id              String   @id @default(cuid())
  tenantId        String
  workspaceAreaId String?
  name            String
  description     String?
  color           String?
  isActive        Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceArea WorkspaceArea?  @relation(fields: [workspaceAreaId], references: [id], onDelete: SetNull)
  createdBy     User            @relation("SocialBrandCreatedBy", fields: [createdById], references: [id])
  contents      SocialContent[]
  accounts      SocialAccount[]
  hashtags      SocialHashtag[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([workspaceAreaId])
}

model SocialContent {
  id              String              @id @default(cuid())
  tenantId        String
  workspaceAreaId String?
  socialBrandId   String?
  createdById     String
  title           String
  description     String?
  contentText     String?
  internalNotes   String?
  contentType     SocialContentType   @default(POST)
  status          SocialContentStatus @default(DRAFT)
  scheduledAt     DateTime?
  timezone        String              @default("Europe/Istanbul")
  edited          Boolean             @default(false)
  approved        Boolean             @default(false)
  readyToPublish  Boolean             @default(false)
  published       Boolean             @default(false)
  publishedAt     DateTime?
  /// Future per-platform copy overrides: { INSTAGRAM?: string, ... }
  platformCopy    Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceArea WorkspaceArea?          @relation(fields: [workspaceAreaId], references: [id], onDelete: SetNull)
  brand         SocialBrand?            @relation(fields: [socialBrandId], references: [id], onDelete: SetNull)
  createdBy     User                    @relation("SocialContentCreatedBy", fields: [createdById], references: [id])
  platforms     SocialContentPlatform[]
  media         SocialContentMedia[]
  destinations  SocialContentDestination[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, socialBrandId])
  @@index([workspaceAreaId])
  @@index([createdById])
}

model SocialHashtag {
  id            String              @id @default(cuid())
  tenantId      String
  socialBrandId String
  tag           String
  tagKey        String
  status        SocialHashtagStatus @default(ACTIVE)
  category      String?
  notes         String?
  usageCount    Int                 @default(0)
  lastUsedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand  SocialBrand @relation(fields: [socialBrandId], references: [id], onDelete: Cascade)

  @@unique([tenantId, socialBrandId, tagKey])
  @@index([tenantId, socialBrandId, status])
  @@index([tenantId, status])
}

model SocialContentPlatform {
  id              String         @id @default(cuid())
  tenantId        String
  socialContentId String
  platform        SocialPlatform
  /// Future: linked SocialAccount
  socialAccountId String?
  publicationStatus String?
  externalPostId  String?
  createdAt       DateTime       @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  content SocialContent @relation(fields: [socialContentId], references: [id], onDelete: Cascade)

  @@unique([socialContentId, platform])
  @@index([tenantId])
  @@index([tenantId, platform])
}

model SocialContentMedia {
  id              String   @id @default(cuid())
  tenantId        String
  socialContentId String
  mediaAssetId    String
  position        Float
  role            String?
  createdAt       DateTime @default(now())

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  content    SocialContent @relation(fields: [socialContentId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([socialContentId, mediaAssetId])
  @@index([tenantId])
  @@index([socialContentId, position])
  @@index([mediaAssetId])
}

model SocialOAuthSession {
  id                      String         @id @default(cuid())
  tenantId                String
  userId                  String
  provider                SocialProvider @default(META)
  state                   String         @unique
  expiresAt               DateTime
  consumedAt              DateTime?
  reconnectConnectionId   String?
  createdAt               DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
}

model SocialConnection {
  id                   String                 @id @default(cuid())
  tenantId             String
  provider             SocialProvider         @default(META)
  externalUserId       String?
  accessTokenEncrypted String
  accessTokenIv        String
  accessTokenTag       String
  expiresAt            DateTime?
  grantedScopes        Json
  status               SocialConnectionStatus @default(CONNECTED)
  createdById          String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User            @relation("SocialConnectionCreatedBy", fields: [createdById], references: [id])
  accounts  SocialAccount[]

  @@index([tenantId])
  @@index([tenantId, provider, status])
  @@index([createdById])
}

model SocialAccount {
  id                   String                 @id @default(cuid())
  tenantId             String
  socialConnectionId   String
  socialBrandId        String?
  platform             SocialPlatform
  externalAccountId    String
  parentExternalId     String?
  name                 String
  username             String?
  profilePictureUrl    String?
  accountType          String?
  accessTokenEncrypted String?
  accessTokenIv        String?
  accessTokenTag       String?
  tokenExpiresAt       DateTime?
  isActive             Boolean                @default(true)
  connectionStatus     SocialConnectionStatus @default(CONNECTED)
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  tenant     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection SocialConnection           @relation(fields: [socialConnectionId], references: [id], onDelete: Cascade)
  brand      SocialBrand?               @relation(fields: [socialBrandId], references: [id], onDelete: SetNull)
  destinations SocialContentDestination[]

  @@unique([tenantId, platform, externalAccountId])
  @@index([tenantId])
  @@index([tenantId, platform, isActive])
  @@index([socialConnectionId])
  @@index([socialBrandId])
}

model SocialContentDestination {
  id                  String                  @id @default(cuid())
  tenantId            String
  socialContentId     String
  socialAccountId     String
  platform            SocialPlatform
  publicationStatus   SocialPublicationStatus @default(PENDING)
  externalPostId      String?
  externalContainerId String?
  permalink           String?
  errorCode           String?
  errorMessage        String?
  publishedAt         DateTime?
  lastAttemptAt       DateTime?
  attemptCount        Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  content SocialContent @relation(fields: [socialContentId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)

  @@unique([socialContentId, socialAccountId])
  @@index([tenantId])
  @@index([tenantId, publicationStatus])
  @@index([socialAccountId])
}
